# Local development: local (SQLite Auth/attempts + PGlite content). Vercel always uses Supabase; no local fallback.
# Internal compatibility env names are intentionally retained so the rebrand does not change runtime behavior.
LEVELUP_BACKEND=local
LEVELUP_DATA_DIR=.data

# Public URL used for metadata, OAuth-facing links, and deploy-time branding.
# Production example: https://your-vectra-domain.example
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set these in Vercel Project Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://azrpaihfdtghcbdxkhqh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key supported as an alternative to the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret. NEVER prefix with NEXT_PUBLIC_ or commit its value.
SUPABASE_SERVICE_ROLE_KEY=
